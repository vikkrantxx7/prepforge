{
	"name": "@prepforge/api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch --env-file=.env src/main.ts",
		"build": "tsc",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx --env-file=.env src/db/migrate.ts",
		"start": "node --env-file=.env dist/main.js",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@fastify/cors": "^10.0.0",
		"@fastify/jwt": "^10.2.2",
		"@prepforge/shared": "workspace:*",
		"drizzle-orm": "^0.45.3",
		"fastify": "^5.3.0",
		"fastify-plugin": "^6.0.0",
		"pg": "^8.23.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.11",
		"tsx": "^4.19.0",
		"typescript": "^5.9.3"
	}
}
